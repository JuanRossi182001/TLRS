# Runtime environment for backend behavior and defaults.
ENVIRONMENT=development

# Database connection used by the API and workers.
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/tlrs
DB_SCHEMA_NAME=public

# Redis used by realtime tickets, Pub/Sub and shared backend state.
REDIS_URL=redis://redis:6379/0

# Base MQTT broker connection used by the platform.
MQTT_HOST=your-emqx-host.emqxsl.com
MQTT_PORT=8883
MQTT_TLS_ENABLED=true

# Worker credentials used to consume telemetry from MQTT.
MQTT_USERNAME=gps_worker
MQTT_PASSWORD=change-me

# Command dispatcher credentials used for downlinks and acknowledgements.
MQTT_DISPATCHER_USERNAME=command_dispatcher
MQTT_DISPATCHER_PASSWORD=change-me

# Optional MQTT topic overrides used by some local/dev flows.
MQTT_LOCATION_TOPIC=gps/devices/+/location
MQTT_ACK_TOPIC=gps/devices/+/acks
MQTT_PUBLIC_PORT=8883
EMQX_WS_PORT=8084

# Encryption key used to protect stored device credentials.
CREDENTIAL_ENCRYPTION_KEY=change-me-with-a-base64-key

# JWT and session settings used for login, refresh and websocket tickets.
JWT_SECRET_KEY=change-me-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_PATH=/user/auth
USER_SESSION_MAX_ACTIVE_SESSIONS=5
USER_SESSION_CLEANUP_RETENTION_DAYS=2
USER_SESSION_CLEANUP_INTERVAL_HOURS=6
WEBSOCKET_TICKET_TTL_SECONDS=60

# Allowed frontend origins for CORS and WebSocket Origin validation.
# Use localhost:5173 for local Vite development and replace/add real frontend domains in staging/prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional EMQX management API settings used by helper scripts or provisioning flows.
EMQX_API_BASE_URL=https://your-emqx-host.emqxsl.com:8443/api/v5
EMQX_API_KEY=change-me
EMQX_API_SECRET=change-me
EMQX_AUTHENTICATION_ID=password_based:built_in_database
EMQX_AUTHORIZATION_ENABLED=true

# ChirpStack MQTT event worker connection used to process device events.
CHIRPSTACK_MQTT_HOST=your-emqx-host.emqxsl.com
CHIRPSTACK_MQTT_PORT=8883
CHIRPSTACK_MQTT_USERNAME=chirpstack_event_worker
CHIRPSTACK_MQTT_PASSWORD=change-me
CHIRPSTACK_MQTT_USE_TLS=true
CHIRPSTACK_MQTT_TOPIC_FILTER=application/+/device/+/event/+

# ChirpStack API connection used for provisioning and downlinks.
# In Docker compose this is usually the service name `chirpstack`; outside Docker it may be localhost or another host.
CHIRPSTACK_API_HOST=chirpstack
CHIRPSTACK_API_PORT=8080
CHIRPSTACK_API_TOKEN=change-me
CHIRPSTACK_API_USE_TLS=false
CHIRPSTACK_API_TIMEOUT_SECONDS=10
CHIRPSTACK_DOWNLINK_TRANSPORT=grpc
COMMAND_DEFAULT_EXPIRES_SECONDS=1200

# ChirpStack resource IDs used by provisioning helpers and local scripts.
CHIRPSTACK_TENANT_ID=change-me
CHIRPSTACK_APPLICATION_ID=change-me
CHIRPSTACK_DEVICE_PROFILE_ID=change-me

# Device identifiers used by local ChirpStack tests and simulator flows.
CHIRPSTACK_DEV_EUI=0102030405060708
CHIRPSTACK_JOIN_EUI=0000000000000000
CHIRPSTACK_APP_KEY=00000000000000000000000000000000
CHIRPSTACK_GATEWAY_ID=0102030405060708

# LoRaWAN defaults used by simulator and ChirpStack helper scripts.
LORAWAN_REGION=au915_0
LORAWAN_TOPIC_PREFIX=au915_0

# Simulator settings used only by local telemetry simulation scripts.
SIM_SCENARIO=inside-outside
SIM_DURATION=0s
SIM_OTAA_DELAY=0s
SIM_UPLINK_INTERVAL=15s
SIM_ACK_DELAY=2s
SIM_CONFIRMED_UPLINK=false
SIM_SHAPE_HEX=
SIM_JITTER_METERS=0
SIM_ALTITUDE_METERS=520.4
SIM_ACCURACY_METERS=4.8
SIM_BATTERY_START=87
SIM_TX_FREQUENCY=915200000
SIM_TX_BANDWIDTH=125000
SIM_TX_SPREADING_FACTOR=7
